{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaplumbaga",
  "compatibility_date": "2026-10-10",
  // static assets only, no Worker script: requests are free and unlimited
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // The custom domain kaplumbaga.eren.sh is attached once, outside this file,
  // so deploys never touch it and the CI token needs no zone access. To attach
  // it again: npx wrangler deploy --domain kaplumbaga.eren.sh
  "workers_dev": false
}
